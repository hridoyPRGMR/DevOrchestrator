<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.13.18" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="System.Text.Json" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DevOrchestrator.Application/DevOrchestrator.Application.csproj"></ProjectReference>
    <ProjectReference Include="../DevOrchestrator.Infrastructure/DevOrchestrator.Infrastructure.csproj"></ProjectReference>
    <ProjectReference Include="../DevOrchestrator.Contracts/DevOrchestrator.Contracts.csproj"></ProjectReference>
    <ProjectReference Include="../DevOrchestrator.Tools/DevOrchestrator.Tools.csproj"></ProjectReference>
  </ItemGroup>

</Project>
